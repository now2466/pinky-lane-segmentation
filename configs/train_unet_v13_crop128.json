    "dice_weight": 0.3,
    "seed": 42,
    "workers": 2,
    "device": "cuda",
    "amp": false,
    "cpu_threads": 4,
    "crosswalk_sample_multiplier": 1.0,
    "selection_metric": "fixed_foreground",
    "early_stopping_patience": 0,
    "min_delta": 0,
    "lr_scheduler": "none",
    "confirmed_background_dice": true
  }
